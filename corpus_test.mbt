d":"pass","origin":"independent regression"},{"name":"undefined","rules":"check: $missing","input":"x","expected":"error","origin":"independent regression"},{"name":"same-pattern-ref","rules":"check: $(v=a)$v","input":"aa","expected":"error","origin":"independent regression"},{"name":"duplicate-capture","rules":"check: $(v=a)$(v=b)","input":"ab","expected":"error","origin":"independent regression"},{"name":"capture-in-not","rules":"not: $(v=a)","input":"b","expected":"error","origin":"independent regression"},{"name":"unterminated","rules":"check: $(v=abc","input":"abc","expected":"error","origin":"independent regression"},{"name":"bad-regex","rules":"check: $(v=[)","input":"abc","expected":"error","origin":"independent regression"},{"name":"bad-dollar","rules":"check: $","input":"x","expected":"error","origin":"independent regression"},{"name":"regex-name","rules":"regex: =x","input":"x","expected":"error","origin":"independent regression"},{"name":"negative-capture-ref","rules":"regex: V=[a-z]+\nnot: $(v=$V)","input":"x","expected":"error","origin":"independent regression"},{"name":"trailing-not","rules":"check: start\nnot: error","input":"start error","expected":"fail","origin":"independent regression"},{"name":"negative-boundary-window","rules":"check: one$()\nnot: half\ncheck: $()two","input":"onehalftwo","expected":"fail","origin":"independent regression"},{"name":"negative-before","rules":"not: error\ncheck: start","input":"error start","expected":"fail","origin":"independent regression"},{"name":"negative-after","rules":"not: error\ncheck: start","input":"start error","expected":"pass","origin":"independent regression"},{"name":"unordered-overlap","rules":"unordered: same\nunordered: same","input":"same","expected":"pass","origin":"independent regression"},{"name":"unordered-barrier","rules":"unordered: one\nunordered: two\ncheck: three","input":"two three one","expected":"fail","origin":"independent regression"},{"name":"unordered-reversed","rules":"unordered: one\nunordered: two\ncheck: three","input":"two one three","expected":"pass","origin":"independent regression"},{"name":"unordered-dependency","rules":"regex: R=r[0-9]+\nunordered: $(v=$R) = load\nunordered: use $v","input":"use r1\nr1 = load","expected":"fail","origin":"independent regression"},{"name":"negative-frozen-value","rules":"check: $(v=a)\nnot: $v\ncheck: $(v=b)","input":"a b a","expected":"pass","origin":"independent regression"},{"name":"unicode-cjk","rules":"check: 世界","input":"你好 世界","expected":"pass","origin":"independent regression"},{"name":"unicode-boundary","rules":"check: 世界","input":"字世界","expected":"fail","origin":"independent regression"},{"name":"unicode-emoji","rules":"check: hello","input":"😀 hello","expected":"pass","origin":"independent regression"},{"name":"unicode-supplementary-letter","rules":"check: 𐐀","input":"😀 𐐀","expected":"pass","origin":"independent regression"},{"name":"unicode-word-class","rules":"check: $(v=\\w+)\nnextln: $v","input":"世界𐐀\n世界𐐀","expected":"pass","origin":"independent regression"},{"name":"crlf","rules":"check: one\r\nnextln: two","input":"one\r\ntwo","expected":"pass","origin":"independent regression"},{"name":"newline-not-optional","rules":"check: one\nnextln: two","input":"one\n\ntwo","expected":"fail","origin":"independent regression"},{"name":"multiline-anchor","rules":"check: $(=^two$)","input":"one\ntwo\nthree","expected":"pass","origin":"independent regression"},{"name":"named-regex","rules":"check: $(v=(?P<inner>[a-z]+))","input":"abc","expected":"pass","origin":"independent regression"},{"name":"escaped-non-bmp","rules":"check: $(=\\𐐀)","input":"𐐀","expected":"error","origin":"independent regression"}]
    ),
